{
  "name": "swimcity",
  "version": "1.0.0",
  "description": "An Expo app for discovering Helsinki swimming spots with City of Helsinki observations.",
  "author": "Miguel Duarte",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miguelduartedev/SwimCity.git"
  },
  "bugs": {
    "url": "https://github.com/miguelduartedev/SwimCity/issues"
  },
  "homepage": "https://github.com/miguelduartedev/SwimCity#readme",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.14",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.102.8",
    "expo": "~57.0.18",
    "expo-constants": "~57.0.16",
    "expo-font": "~57.0.2",
    "expo-linking": "~57.0.8",
    "expo-location": "~57.0.14",
    "expo-router": "~57.0.17",
    "expo-status-bar": "~57.0.1",
    "leaflet": "^1.9.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/leaflet": "^1.9.22",
    "@types/react": "~19.2.2",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native|expo(?:-[^/]+)?|@expo(nent)?/.*|@tanstack/react-query)/)"
    ]
  },
  "private": true
}
